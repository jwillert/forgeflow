# GitHub access token used by Forgeflow provider actions and gh CLI helpers.
# Needs repo contents/issues/pull-request permissions for private repos.
GH_TOKEN=

# Repository watched by this project's .forgeflow config.
# Example: jwillert/coralive-app
FORGEFLOW_GITHUB_REPO=

# SQLite database path for Forgeflow state.
FORGEFLOW_DB=.forgeflow/forgeflow.db

# Base branch used for implementation work branches.
FORGEFLOW_BASE_REF=main

# Max provider events/deferred commands handled per run.
FORGEFLOW_MAX_EVENTS=100

# Number of queued commands run concurrently by .forgeflow/run.ts.
FORGEFLOW_PARALLEL=3

# Optional cap for commands claimed in one worker run. Empty means defaults to FORGEFLOW_PARALLEL.
FORGEFLOW_LIMIT=

# Podman image used by Sandcastle sandbox provider.
FORGEFLOW_SANDBOX_IMAGE=forgeflow-agent

# Build settings for .forgeflow/build-image.sh.
FORGEFLOW_SANDBOX_DOCKERFILE=.forgeflow/Dockerfile
FORGEFLOW_SANDBOX_BUILD_CONTEXT=.

# Optional command executed inside sandbox after creation, before agent run.
# Example: ./gradlew --no-daemon assemble
FORGEFLOW_SANDBOX_PREFLIGHT=

# Optional output directory used by local workflows.
FORGEFLOW_OUTPUT_DIR=/tmp/forgeflow-output

# Pi agent model settings used by .forgeflow/shared/sandcastle.ts.
PI_MODEL=openai-codex/gpt-5.5
PI_THINKING=medium
